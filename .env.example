# Webhook do canal do Discord onde as ofertas serão publicadas
DISCORD_WEBHOOK_URL=

# Nome exibido pelo bot ao postar no Discord
DISCORD_WEBHOOK_USERNAME=FURAO PROMO

# String de conexão do PostgreSQL.
# No Railway, isso é preenchido automaticamente ao linkar o serviço
# de banco de dados (variável ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# Máximo de posts analisados por canal a cada execução (opcional)
# MAX_POSTS_PER_SOURCE=30
